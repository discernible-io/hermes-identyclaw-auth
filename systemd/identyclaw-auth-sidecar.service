[Unit]
Description=IdentyClaw Passport auth sidecar (localhost RODiT for Hermes A2A/webhooks)
Documentation=https://github.com/discernible-io/hermes-identyclaw-auth
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Prefer scripts/install-sidecar-unit.sh which rewrites WorkingDirectory for this host.
WorkingDirectory=%h/.hermes/plugins/identyclaw-auth
Environment=HERMES_HOME=%h/.hermes
Environment=IDENTYCLAW_AUTH_PORT=9910
EnvironmentFile=-%h/.hermes/.env
# NEAR_CREDENTIALS_FILE_PATH must be set in ~/.hermes/.env (or override here).
ExecStart=/usr/bin/env node ./bin/sidecar.mjs --port ${IDENTYCLAW_AUTH_PORT}
Restart=on-failure
RestartSec=3
# Bind is 127.0.0.1 only (enforced by the sidecar).

[Install]
WantedBy=default.target
